{
  "expo": {
    "name": "GSClimbing Mobile",
    "slug": "gsclimbing-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/search.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/search.png",
      "resizeMode": "contain",
      "backgroundColor": "#670B25"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gsclimbing.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Esta app precisa de acesso à câmara para tirar fotos dos relatórios de inspeção.",
        "NSPhotoLibraryUsageDescription": "Esta app precisa de acesso à galeria para guardar e aceder a fotos dos relatórios.",
        "NSPhotoLibraryAddUsageDescription": "Esta app precisa de permissão para guardar fotos na galeria."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/search.png",
        "backgroundColor": "#670B25"
      },
      "package": "com.gsclimbing.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/search.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir $(PRODUCT_NAME) aceder à sua câmara para tirar fotos dos relatórios."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Permitir $(PRODUCT_NAME) aceder às suas fotos.",
          "savePhotosPermission": "Permitir $(PRODUCT_NAME) guardar fotos na galeria."
        }
      ]
    ],
    "scheme": "gsclimbing",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
